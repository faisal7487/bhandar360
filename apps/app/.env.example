# Supabase Postgres connection — Project Settings -> Database -> Connection string.
# On serverless (Vercel) use the "Transaction pooler" — port 6543 — so many
# short-lived function instances share the small connection budget. The app is
# transaction-mode safe. Locally, the session pooler (5432) or a direct
# connection is fine too.
#
# Preferred: discrete fields. Supabase passwords often contain characters
# (%, +, etc.) that aren't valid unescaped in a URI, so these avoid any
# URL-encoding/decoding pitfalls — the password is used as a literal string.
PGHOST=aws-0-<region>.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.<project-ref>
PGPASSWORD=your-db-password
PGDATABASE=postgres

# Once the schema is stable you can stop the app from trying to run migrations
# on cold start (they're idempotent no-ops anyway):
# RUN_MIGRATIONS=false

# Alternative: a single connection string (only if your password is URI-safe).
# Ignored if PGHOST is set above.
# DATABASE_URL=postgresql://postgres:your-db-password@db.xxxxxxxx.supabase.co:5432/postgres

# JWT signing secret for auth cookies. Falls back to an insecure dev-only
# default when unset — REQUIRED (server refuses to start otherwise) when
# NODE_ENV=production. Generate one with: openssl rand -base64 48
# JWT_SECRET=change-me

# Set to "production" for a production start (enables the JWT_SECRET check
# above and hides internal error details from API responses).
# NODE_ENV=production
